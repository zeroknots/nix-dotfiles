bold-is-bright = true

theme = sonokai
background = 1a1b26
mouse-hide-while-typing = true
macos-window-shadow = false
#adjust-cell-height = 15%
window-colorspace = "display-p3"
clipboard-read = "allow"
clipboard-trim-trailing-spaces = true
clipboard-write = "allow"
window-decoration = false
window-padding-x = 0
window-padding-y = 0
font-family = "JetBrainsMono Nerd Font Mono"
font-family = "JetBrainsMonoNL Nerd Font Mono"
keybind = ctrl+p=text:\x3a\x47\x6f\x54\x6f\x46\x69\x6c\x65\x0a
keybind = ctrl+i=text:\x3a\x54\x65\x6c\x65\x73\x63\x6f\x70\x65\x20\x73\x6d\x61\x72\x74\x5f\x67\x6f\x74\x6f\x0a
keybind = cmd+t=text:\x01\x54
keybind = ctrl+t=text:\x01\x74
keybind = ctrl+u=text:\x01-
keybind = ctrl+m=text:\x01m


